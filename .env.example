PORT=3010
DATABASE_URL=postgresql://postgres:postgres@localhost:5439/whatsapp_notifier
LOG_LEVEL=info
PRINT_QR_IN_TERMINAL=false
WWEBJS_AUTH_DIR=.wwebjs_auth
WWEBJS_HEADLESS=true
WWEBJS_TAKEOVER_ON_CONFLICT=false
WWEBJS_EXECUTABLE_PATH=
PUPPETEER_EXECUTABLE_PATH=
API_KEY=replace-with-a-long-random-value

ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_COOLDOWN_MS=3600000
RESTORE_SESSIONS_ON_STARTUP=false
RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=900000
